{
  "schema": "fedworldmix.isolated_hpt_base_config.v1",
  "source_checkpoint_protocol": "fedvla_iccv2025 old-line r1000 paper schedule",
  "task_split": {
    "tasks": ["door-lock", "close-drawer", "sweep-into", "open-window"],
    "clients_per_task": 1
  },
  "train": {
    "rounds": 1000,
    "local_epochs": 5,
    "batch_size": 256,
    "learning_rate": 0.000005,
    "seed": 31,
    "experiment_mode": "fedavg",
    "aggregation": "fedavg",
    "backend": "torch",
    "torch_device": "cuda:0",
    "max_samples_per_client": 0,
    "use_iosp": true,
    "use_dgmoe": true,
    "trunk_merge_alpha": 0.0,
    "grad_clip_norm": 1.0,
    "skip_nonfinite_updates": true
  },
  "model": {
    "backbone": "hpt",
    "hpt_pretrained": "base",
    "hpt_head_architecture": "regression",
    "hpt_use_state": true,
    "hpt_freeze_trunk": false,
    "hpt_freeze_encoders": true,
    "hpt_camera_views": ["corner", "top", "shoulder"],
    "hpt_use_dgmoe": true,
    "hpt_dgmoe_impl": "adapter",
    "hpt_dgmoe_num_experts": 4,
    "hpt_dgmoe_expert_hidden_dim": 128,
    "hpt_dgmoe_lambda": 0.5,
    "hpt_dgmoe_temperature": 1.0,
    "hpt_dgmoe_renormalize_gates": false,
    "hpt_dgmoe_gate_residual": true,
    "hpt_dgmoe_force_active": true,
    "hpt_freeze_trunk_attention": true,
    "hpt_freeze_trunk_mlp": true,
    "hpt_text_embed_model": "openai/clip-vit-base-patch32",
    "hpt_text_embed_dim": 32,
    "hpt_text_embed_scale": 1.0,
    "hpt_text_embed_mode": "language",
    "hpt_iosp_mode": "clip",
    "hpt_iosp_embed_model": "openai/clip-vit-base-patch32",
    "hpt_iosp_embed_dim": 512,
    "hpt_iosp_embed_scale": 1.0,
    "hpt_iosp_group_moe": true,
    "hpt_iosp_group_moe_num_experts": 4,
    "hpt_iosp_group_moe_hidden_dim": 128,
    "hpt_iosp_group_moe_lambda": 0.5,
    "hpt_iosp_group_moe_temperature": 1.0,
    "hpt_iosp_group_moe_renormalize_gates": false,
    "hpt_iosp_group_moe_gate_residual": true,
    "hpt_iosp_clip_model": "openai/clip-vit-base-patch32",
    "hpt_iosp_clip_image_size": 224,
    "hpt_iosp_clip_strategy": "hpt_stem_latent",
    "hpt_iosp_clip_remaining_max": 0,
    "hpt_iosp_perm_suffix": ".iospperm_s224_k8_r0.npz"
  },
  "output_dir": "runs/p2_hpt"
}

